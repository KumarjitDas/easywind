{{#each breakPoints as |bp_size bp_name|}}
  {{#if bp_size}}
@media (min-width: {{bp_size}}px) {

  {{#each ../sizings as |sizing|}}
  .{{bp_name}}\:box-sizing-{{sizing}} {
    box-sizing: {{sizing}};
  }
  {{/each}}

}
  {{else}}
{{#each ../sizings as |sizing|}}
.box-sizing-{{sizing}},
.{{bp_name}}\:box-sizing-{{sizing}} {
  box-sizing: {{sizing}};
}
{{/each}}
  {{/if}}
{{/each}}
