    {{#if (or (eq percent 100) (eq percent -100))}}
  .{{bp_name}}\:{{#if (lt percent 0)}}-{{/if}}left-full,
    {{/if}}
  .{{bp_name}}\:{{#if (lt percent 0)}}-{{/if}}left-{{abs percent}}per {
    left: {{percent}}{{#if percent}}%{{/if}};
  }
  {{/each}}

}
  {{else}}
