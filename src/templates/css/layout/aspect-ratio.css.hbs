{{#each breakPoints as |bp_size bp_name|}}
  {{#if bp_size}}
@media (min-width: {{bp_size}}px) {

  .{{bp_name}}\:aspect-auto {
    aspect-ratio: auto;
  }
  .{{bp_name}}\:aspect-square,
  .{{bp_name}}\:aspect-1\/1 {
    aspect-ratio: 1 / 1;
  }
  .{{bp_name}}\:aspect-video {
    aspect-ratio: var(--ew-aspect-ratio-video, 16 / 9);
  }
  {{#each ../aspectRatios as |ratio|}}
  .{{bp_name}}\:aspect-{{ratio.[0]}}\/{{ratio.[1]}} {
    aspect-ratio: {{ratio.[0]}} / {{ratio.[1]}};
  }
  {{/each}}

}
  {{else}}
.aspect-auto,
.{{bp_name}}\:aspect-auto {
  aspect-ratio: auto;
}
.aspect-square,
.aspect-1\/1,
.{{bp_name}}\:aspect-square,
.{{bp_name}}\:aspect-1\/1 {
  aspect-ratio: 1 / 1;
}
.aspect-video,
.{{bp_name}}\:aspect-video {
  aspect-ratio: var(--ew-aspect-ratio-video, 16 / 9);
}
{{#each ../aspectRatios as |ratio|}}
.aspect-{{ratio.[0]}}\/{{ratio.[1]}},
.{{bp_name}}\:aspect-{{ratio.[0]}}\/{{ratio.[1]}} {
  aspect-ratio: {{ratio.[0]}} / {{ratio.[1]}};
}
{{/each}}
  {{/if}}
{{/each}}
