{{#each breakPoints as |bp_size bp_name|}}
  {{#if bp_size}}
@media (min-width: {{bp_size}}px) {

  {{#each ../breaks as |break|}}
    {{#if (eq break 'all')}}
  /*noinspection CssInvalidPropertyValue,CssOverwrittenProperties*/
    {{/if}}
  .{{bp_name}}\:break-before-{{break}} {
    {{#if (eq break 'all')}}
    break-before: always;
    {{/if}}
    break-before: {{break}};
  }
  {{/each}}

}
  {{else}}
{{#each ../breaks as |break|}}
  {{#if (eq break 'all')}}
/*noinspection CssInvalidPropertyValue,CssOverwrittenProperties*/
  {{/if}}
.break-before-{{break}},
.{{bp_name}}\:break-before-{{break}} {
{{#if (eq break 'all')}}
  break-before: always;
{{/if}}
  break-before: {{break}};
}
{{/each}}
  {{/if}}
{{/each}}
