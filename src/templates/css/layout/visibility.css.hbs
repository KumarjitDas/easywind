{{#each breakPoints as |bp_size bp_name|}}
  {{#if bp_size}}
@media (min-width: {{bp_size}}px) {

  {{#each ../visibilities as |vis_val vis_key|}}
  .{{bp_name}}\:{{vis_key}} {
    visibility: {{vis_val}};
  }
  {{/each}}

}
  {{else}}
{{#each ../visibilities as |vis_val vis_key|}}
.{{vis_key}},
.{{bp_name}}\:{{vis_key}} {
  visibility: {{vis_val}};
}
{{/each}}
  {{/if}}
{{/each}}
