{{#each breakPoints as |bp_size bp_name|}}
  {{#if bp_size}}
@media (min-width: {{bp_size}}px) {

  {{#each ../overflows as |overflow|}}
  .{{bp_name}}\:overflow-{{overflow}} {
    overflow: {{overflow}};
  }
  .{{bp_name}}\:overflow-x-{{overflow}} {
    overflow-x: {{overflow}};
  }
  .{{bp_name}}\:overflow-y-{{overflow}} {
    overflow-y: {{overflow}};
  }
  {{/each}}

}
  {{else}}
{{#each ../overflows as |overflow|}}
.overflow-{{overflow}},
.{{bp_name}}\:overflow-{{overflow}} {
  overflow: {{overflow}};
}
.overflow-x-{{overflow}},
.{{bp_name}}\:overflow-x-{{overflow}} {
  overflow-x: {{overflow}};
}
.overflow-y-{{overflow}},
.{{bp_name}}\:overflow-y-{{overflow}} {
  overflow-y: {{overflow}};
}
{{/each}}
  {{/if}}
{{/each}}
