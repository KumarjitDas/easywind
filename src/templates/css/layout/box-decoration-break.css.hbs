{{#each breakPoints as |bp_size bp_name|}}
  {{#if bp_size}}
@media (min-width: {{bp_size}}px) {

  {{#each ../breaks as |break|}}
  .{{bp_name}}\:box-decoration-break-{{break}} {
    box-decoration-break: {{break}};
  }
  {{/each}}

}
  {{else}}
{{#each ../breaks as |break|}}
.box-decoration-break-{{break}},
.{{bp_name}}\:box-decoration-break-{{break}} {
  box-decoration-break: {{break}};
}
{{/each}}
  {{/if}}
{{/each}}
