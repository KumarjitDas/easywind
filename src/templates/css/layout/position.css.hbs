{{#each breakPoints as |bp_size bp_name|}}
  {{#if bp_size}}
@media (min-width: {{bp_size}}px) {

  {{#each ../positions as |position|}}
  .{{bp_name}}\:{{position}} {
    position: {{position}};
  }
  {{/each}}

}
  {{else}}
{{#each ../positions as |position|}}
.{{position}},
.{{bp_name}}\:{{position}} {
  position: {{position}};
}
{{/each}}
  {{/if}}
{{/each}}
